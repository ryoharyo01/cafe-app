# Copy to .env.local (dev) or deploy/.env (Docker) and fill in. Never commit the filled copy.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret: server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL of the app (payment callback, QR links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Random string for signing staff sessions:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret

# --- AI barista (optional, any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional fallback chain, comma separated, tried in order (overrides OPENAI_MODEL)
OPENAI_MODELS=
# Per-attempt / total timeout for the AI chat in ms (defaults 10000 / 30000)
AI_ATTEMPT_TIMEOUT_MS=
AI_TOTAL_TIMEOUT_MS=

# --- Error alerts (optional) ---
# Server errors are also sent to this Telegram chat; leave empty to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum gap between alerts for the same error, ms (default 600000 = 10 min)
ERROR_TELEGRAM_THROTTLE_MS=

# --- Midtrans (optional) ---
# Leave both empty to use the built-in DEMO QRIS payment (no real money).
# Filling them switches to real Midtrans and disables demo mode.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# true = production Midtrans, anything else = sandbox
MIDTRANS_IS_PRODUCTION=false
